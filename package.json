{
  "name": "sticky-quadrant",
  "productName": "Sticky Quadrant",
  "version": "0.1.0",
  "private": true,
  "description": "Sticky Quadrant desktop task management app for Windows.",
  "author": "Zhang Erben <20030419zhanghongyi@gmail.com>",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "build": "vite build",
    "build:renderer": "vite build",
    "pack:win": "npm run build:renderer && electron-builder --win nsis portable",
    "pack:win:portable": "npm run build:renderer && electron-builder --win portable",
    "pack:win:nsis": "npm run build:renderer && electron-builder --win nsis",
    "preview": "vite preview",
    "start": "electron ."
  },
  "build": {
    "appId": "com.stickyquadrant.app",
    "productName": "Sticky Quadrant",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icons/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icons/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Sticky-Quadrant-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "Sticky-Quadrant-Portable-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "electron": "^37.2.0",
    "electron-builder": "^26.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "wait-on": "^8.0.5"
  }
}
